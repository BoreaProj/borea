ARG BASE_IMAGE
FROM ${BASE_IMAGE}
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends debootstrap btrfs-progs e2fsprogs dosfstools gdisk cryptsetup-bin util-linux mount udev git curl tar gzip ca-certificates && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb
